# Copy to .env.local and fill in. NEVER commit real secrets.

# Public base URL of the deployed storefront (used for canonical/hreflang URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments (Whop) -------------------------------------------------------
# Master switch. Keep "false" until a NEW Whop business, products/plans,
# webhooks and fulfillment are configured and tested end to end.
PAYMENTS_ENABLED=false
# Server-side API key of the NEW Whop business (Dashboard > Developer). Never expose to the browser.
WHOP_API_KEY=
# ID of the NEW Whop business/company (starts with biz_ per Whop docs; verify in dashboard).
WHOP_COMPANY_ID=
# Webhook signing secret for /api/webhooks/whop (Dashboard > Developer > Webhooks).
WHOP_WEBHOOK_SECRET=

# --- Fulfillment (CJdropshipping) ------------------------------------------
# Keep "false" until supplier products are mapped and test orders verified.
FULFILLMENT_ENABLED=false
CJ_API_EMAIL=
CJ_API_KEY=
