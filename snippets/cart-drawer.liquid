{%- comment -%}
  AJAX cart drawer. Re-rendered through the Section Rendering API (sections/cart-drawer.liquid).
{%- endcomment -%}
<side-drawer
  id="CartDrawer"
  class="drawer cart-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="CartDrawerTitle"
  aria-hidden="true"
>
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" tabindex="-1">
    <div class="drawer__inner" data-cart-render="drawer">
      <div class="drawer__header">
        <h2 class="drawer__title" id="CartDrawerTitle">
          {{ 'cart.title' | t }}
          {%- if cart.item_count > 0 %} <small>({{ cart.item_count }})</small>{% endif -%}
        </h2>
        <button type="button" class="icon-button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
          {%- render 'icon', icon: 'close' -%}
        </button>
      </div>

      <div class="drawer__body">
        {%- render 'free-shipping-bar' -%}

        {%- if cart.item_count > 0 -%}
          <cart-items>
            <ul class="cart-items" role="list">
              {%- for item in cart.items -%}
                {%- render 'cart-line-item', item: item, index: forloop.index, context: 'drawer' -%}
              {%- endfor -%}
            </ul>
          </cart-items>

          {%- if settings.cart_recommendations -%}
            <div class="mini-recs" data-recommendations-wrapper hidden>
              <h3 class="mini-recs__title">{{ 'cart.recommendations' | t }}</h3>
              <product-recommendations
                data-section-id="mini-recommendations"
                data-product-id="{{ cart.items.first.product_id }}"
                data-limit="6"
                data-intents="complementary,related"
              ></product-recommendations>
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="cart-drawer__empty">
            <span class="cart-drawer__empty-icon">{%- render 'icon', icon: 'bag' -%}</span>
            <p class="h3">{{ 'cart.empty' | t }}</p>
            <p class="text-muted">{{ 'cart.empty_text' | t }}</p>
            <a href="{{ settings.cart_empty_collection.url | default: routes.all_products_collection_url }}" class="button">
              {{- 'cart.empty_cta' | t -}}
            </a>
            {%- if settings.cart_empty_menu != blank and settings.cart_empty_menu.links.size > 0 -%}
              <div class="cart-drawer__empty-links">
                {%- for link in settings.cart_empty_menu.links -%}
                  <a class="chip chip--soft" href="{{ link.url }}">{{ link.title | escape }}</a>
                {%- endfor -%}
              </div>
            {%- endif -%}
            {%- if shop.customer_accounts_enabled and customer == nil -%}
              <p class="text-small text-muted">{{ 'cart.login_html' | t: link: routes.account_login_url }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if cart.item_count > 0 -%}
        <div class="drawer__footer">
          <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm"></form>
          {%- render 'cart-summary', form_id: 'CartDrawerForm', context: 'drawer' -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</side-drawer>
