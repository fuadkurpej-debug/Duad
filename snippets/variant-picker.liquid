{%- comment -%}
  Variant picker (pills, swatches or dropdowns).
  Params: product, section_id, style ('pills' | 'dropdown'), update_url (true/false),
  image_swatches (true/false): color options without a Shopify swatch use the variant's own image
{%- endcomment -%}
{%- unless product.has_only_default_variant -%}
  {%- assign picker_style = style | default: 'pills' -%}
  <variant-picker class="variant-picker variant-picker--{{ picker_style }}" data-section="{{ section_id }}" data-update-url="{{ update_url | default: false }}">
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_down = option.name | downcase
        assign is_color = false
        if option_down contains 'color' or option_down contains 'colour' or option_down contains 'shade'
          assign is_color = true
        endif
        assign option_index = forloop.index0
        assign option_key = 'option' | append: option.position
      -%}
      {%- if picker_style == 'dropdown' -%}
        <div class="variant-picker__option field" data-option-position="{{ option_index }}">
          <label class="form-label" for="Option-{{ section_id }}-{{ option_index }}">{{ option.name | escape }}</label>
          <div class="select">
            <select id="Option-{{ section_id }}-{{ option_index }}" class="select__select" name="options[{{ option.name | escape }}]">
              {%- for value in option.values -%}
                {%- assign value_name = value.name | default: value -%}
                <option value="{{ value_name | escape }}"{% if option.selected_value == value_name %} selected{% endif %}>{{ value_name | escape }}</option>
              {%- endfor -%}
            </select>
            {%- render 'icon', icon: 'chevron-down' -%}
          </div>
        </div>
      {%- else -%}
        <fieldset class="variant-picker__option" data-option-position="{{ option_index }}">
          <legend class="form-label">
            {{ option.name | escape }}<span class="variant-picker__selected">: <span data-selected-value>{{ option.selected_value | escape }}</span></span>
          </legend>
          <div class="variant-pills{% if is_color %} variant-pills--swatch{% endif %}">
            {%- for value in option.values -%}
              {%- liquid
                assign value_name = value.name | default: value
                assign input_id = 'Option-' | append: section_id | append: '-' | append: option_index | append: '-' | append: forloop.index0
                assign swatch_style = ''
                if is_color and value.swatch
                  if value.swatch.image
                    assign swatch_url = value.swatch.image | image_url: width: 80
                    assign swatch_style = 'background-image: url(' | append: swatch_url | append: ');'
                  elsif value.swatch.color
                    assign swatch_style = 'background-color: ' | append: value.swatch.color | append: ';'
                  endif
                endif
                if is_color and swatch_style == blank and image_swatches
                  assign swatch_variant = product.variants | where: option_key, value_name | first
                  if swatch_variant.featured_image
                    assign swatch_url = swatch_variant.featured_image | image_url: width: 120, height: 120, crop: 'center'
                    assign swatch_style = 'background-image: url(' | append: swatch_url | append: ');'
                  endif
                endif
              -%}
              <input
                type="radio"
                class="visually-hidden"
                id="{{ input_id }}"
                name="Option-{{ section_id }}-{{ option_index }}"
                value="{{ value_name | escape }}"
                {% if option.selected_value == value_name %}
                  checked
                {% endif %}
              >
              <label for="{{ input_id }}" class="variant-pill{% if swatch_style != blank %} variant-pill--swatch{% endif %}"{% if swatch_style != blank %} style="{{ swatch_style }}" title="{{ value_name | escape }}"{% endif %}>
                {%- if swatch_style != blank -%}
                  <span class="visually-hidden">{{ value_name | escape }}</span>
                {%- else -%}
                  {{ value_name | escape }}
                {%- endif -%}
              </label>
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endif -%}
    {%- endfor -%}
    <script type="application/json" data-variants>
      {{ product.variants | json }}
    </script>
  </variant-picker>
{%- endunless -%}
