{%- liquid
  assign home_url = request.origin | append: routes.root_url
  assign trail_names = ''
  assign trail_urls = ''
  case request.page_type
    when 'product'
      if collection
        assign trail_names = collection.title
        assign trail_urls = request.origin | append: collection.url
      else
        assign trail_names = 'general.shop_all' | t
        assign trail_urls = request.origin | append: routes.all_products_collection_url
      endif
      assign current_name = product.title
    when 'collection'
      assign trail_names = 'general.collections' | t
      assign trail_urls = request.origin | append: routes.collections_url
      assign current_name = collection.title
    when 'page'
      assign current_name = page.title
    when 'article'
      assign trail_names = blog.title
      assign trail_urls = request.origin | append: blog.url
      assign current_name = article.title
    when 'blog'
      assign current_name = blog.title
  endcase
  assign current_url = canonical_url
-%}
<nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
  <ol role="list">
    <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
    {%- if trail_names != blank -%}
      <li><a href="{{ trail_urls | remove_first: request.origin }}">{{ trail_names | escape }}</a></li>
    {%- endif -%}
    {%- if current_name != blank -%}
      <li aria-current="page">{{ current_name | escape }}</li>
    {%- endif -%}
  </ol>
</nav>

{%- if current_name != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ home_url | json }} },
        {%- if trail_names != blank %}
        { "@type": "ListItem", "position": 2, "name": {{ trail_names | json }}, "item": {{ trail_urls | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ current_name | json }}, "item": {{ current_url | json }} }
        {%- else %}
        { "@type": "ListItem", "position": 2, "name": {{ current_name | json }}, "item": {{ current_url | json }} }
        {%- endif %}
      ]
    }
  </script>
{%- endif -%}
