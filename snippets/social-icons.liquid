{%- liquid
  assign has_social = false
  if settings.social_instagram_link != blank or settings.social_tiktok_link != blank or settings.social_pinterest_link != blank or settings.social_facebook_link != blank or settings.social_youtube_link != blank or settings.social_twitter_link != blank
    assign has_social = true
  endif
-%}
{%- if has_social -%}
  <ul class="social-icons{% if class %} {{ class }}{% endif %}" role="list">
    {%- if settings.social_instagram_link != blank -%}
      <li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_on' | t: platform: 'Instagram' }}">{% render 'icon', icon: 'instagram' %}</a></li>
    {%- endif -%}
    {%- if settings.social_tiktok_link != blank -%}
      <li><a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_on' | t: platform: 'TikTok' }}">{% render 'icon', icon: 'tiktok' %}</a></li>
    {%- endif -%}
    {%- if settings.social_pinterest_link != blank -%}
      <li><a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_on' | t: platform: 'Pinterest' }}">{% render 'icon', icon: 'pinterest' %}</a></li>
    {%- endif -%}
    {%- if settings.social_facebook_link != blank -%}
      <li><a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_on' | t: platform: 'Facebook' }}">{% render 'icon', icon: 'facebook' %}</a></li>
    {%- endif -%}
    {%- if settings.social_youtube_link != blank -%}
      <li><a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_on' | t: platform: 'YouTube' }}">{% render 'icon', icon: 'youtube' %}</a></li>
    {%- endif -%}
    {%- if settings.social_twitter_link != blank -%}
      <li><a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_on' | t: platform: 'X' }}">{% render 'icon', icon: 'x' %}</a></li>
    {%- endif -%}
  </ul>
{%- endif -%}
