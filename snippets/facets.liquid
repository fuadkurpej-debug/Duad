{%- comment -%}
  Filters + sorting for collection and search results (Shopify storefront filtering).
  Configure which filters appear with the Shopify Search & Discovery app.
  Params:
  - results: collection or search object
  - section_id
  - layout: 'drawer' | 'sidebar'
  - enable_filtering, enable_sorting
  - product_count
  - clear_url
  - color_scheme
{%- endcomment -%}
{%- liquid
  assign form_id = 'FacetFiltersForm-' | append: section_id
  assign drawer_id = 'FacetsDrawer-' | append: section_id
  assign sort_by = results.sort_by
  if sort_by == blank
    assign sort_by = results.default_sort_by
  endif
  assign active_count = 0
  for filter in results.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
  assign comma_test = 1234 | money_without_currency
  assign uses_comma = false
  if comma_test contains ','
    assign uses_comma = true
  endif
-%}

<div class="facets-toolbar">
  <div class="facets-toolbar__start">
    {%- if enable_filtering and results.filters.size > 0 -%}
      <button
        type="button"
        class="button button--secondary button--small facets-toggle facets-toggle--{{ layout }}"
        data-drawer-open="{{ drawer_id }}"
        aria-controls="{{ drawer_id }}"
        aria-expanded="false"
      >
        {%- render 'icon', icon: 'filter' -%}
        <span>{{ 'products.facets.filter' | t }}</span>
        <span data-facets-render="toggle-count-{{ section_id }}">{%- if active_count > 0 -%}({{ active_count }}){%- endif -%}</span>
      </button>
    {%- endif -%}
    <p class="facets-toolbar__count" data-facets-render="count-{{ section_id }}" role="status">
      {{- 'products.facets.product_count' | t: count: product_count -}}
    </p>
  </div>
  {%- if enable_sorting and results.sort_options.size > 0 -%}
    <div class="facets-sort">
      <label for="SortBy-{{ section_id }}" class="facets-sort__label">{{ 'products.facets.sort_by' | t }}</label>
      <div class="select">
        <select name="sort_by" id="SortBy-{{ section_id }}" class="select__select" form="{{ form_id }}">
          {%- for option in results.sort_options -%}
            <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
          {%- endfor -%}
        </select>
        {%- render 'icon', icon: 'chevron-down' -%}
      </div>
    </div>
  {%- endif -%}
</div>

<div class="active-facets" data-facets-render="active-{{ section_id }}">
  {%- if active_count > 0 -%}
    {%- for filter in results.filters -%}
      {%- for value in filter.active_values -%}
        <a class="chip" href="{{ value.url_to_remove }}" data-facet-link>
          <span>{{ filter.label | escape }}: {{ value.label | escape }}</span>
          {%- render 'icon', icon: 'close', class: 'icon--small' -%}
          <span class="visually-hidden">{{ 'products.facets.remove_filter' | t }}</span>
        </a>
      {%- endfor -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
          <a class="chip" href="{{ filter.url_to_remove }}" data-facet-link>
            <span>
              {%- if filter.min_value.value -%}{{ filter.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%}
              &ndash;
              {%- if filter.max_value.value -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}
            </span>
            {%- render 'icon', icon: 'close', class: 'icon--small' -%}
            <span class="visually-hidden">{{ 'products.facets.remove_filter' | t }}</span>
          </a>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    <a href="{{ clear_url }}" class="link active-facets__clear" data-facet-link>{{ 'products.facets.clear_all' | t }}</a>
  {%- endif -%}
</div>

{%- if enable_filtering and results.filters.size > 0 -%}
  <facet-filters data-section="{{ section_id }}">
    <side-drawer
      id="{{ drawer_id }}"
      class="drawer drawer--left facets-drawer facets-drawer--{{ layout }}"
      role="dialog"
      aria-modal="true"
      aria-labelledby="FacetsTitle-{{ section_id }}"
      aria-hidden="true"
    >
      <div class="drawer__overlay" data-drawer-close></div>
      <div class="drawer__panel color-{{ color_scheme | default: 'scheme-1' }}" tabindex="-1">
        <div class="drawer__header">
          <h2 class="drawer__title" id="FacetsTitle-{{ section_id }}">{{ 'products.facets.filter' | t }}</h2>
          <button type="button" class="icon-button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
            {%- render 'icon', icon: 'close' -%}
          </button>
        </div>
        <div class="drawer__body">
          <form id="{{ form_id }}" class="facets-form" action="{{ request.path }}" method="get">
            {%- if results.terms -%}
              <input type="hidden" name="q" value="{{ results.terms | escape }}">
              <input type="hidden" name="options[prefix]" value="last">
            {%- endif -%}

            {%- for filter in results.filters -%}
              {%- assign filter_key = filter.param_name | handle -%}
              <details class="accordion facet" data-accordion{% if forloop.index <= 3 or filter.active_values.size > 0 %} open{% endif %}>
                <summary>
                  <h3 class="accordion__title">
                    {{ filter.label | escape }}
                    <span class="facet__selected" data-facets-render="selected-{{ section_id }}-{{ filter_key }}">
                      {%- if filter.active_values.size > 0 -%}({{ filter.active_values.size }}){%- endif -%}
                    </span>
                  </h3>
                  <span class="accordion__toggle" aria-hidden="true"></span>
                </summary>
                <div class="accordion__content" data-accordion-content>
                  <div class="accordion__content-inner" data-facets-render="filter-{{ section_id }}-{{ filter_key }}">
                    {%- case filter.type -%}
                      {%- when 'price_range' -%}
                        {%- liquid
                          if uses_comma
                            assign min_display = filter.min_value.value | money_without_currency | replace: '.', '' | replace: ',', '.'
                            assign max_display = filter.max_value.value | money_without_currency | replace: '.', '' | replace: ',', '.'
                            assign range_max = filter.range_max | money_without_currency | replace: '.', '' | replace: ',', '.'
                          else
                            assign min_display = filter.min_value.value | money_without_currency | replace: ',', ''
                            assign max_display = filter.max_value.value | money_without_currency | replace: ',', ''
                            assign range_max = filter.range_max | money_without_currency | replace: ',', ''
                          endif
                        -%}
                        <div class="facet__price">
                          <div class="field">
                            <label class="field__label" for="Filter-{{ section_id }}-price-gte">{{ 'products.facets.price_from' | t }} ({{ cart.currency.symbol }})</label>
                            <input
                              class="field__input"
                              data-price-input
                              type="number"
                              inputmode="decimal"
                              id="Filter-{{ section_id }}-price-gte"
                              name="{{ filter.min_value.param_name }}"
                              {% if filter.min_value.value %}
                                value="{{ min_display }}"
                              {% endif %}
                              placeholder="0"
                              min="0"
                              max="{{ range_max }}"
                            >
                          </div>
                          <div class="field">
                            <label class="field__label" for="Filter-{{ section_id }}-price-lte">{{ 'products.facets.price_to' | t }} ({{ cart.currency.symbol }})</label>
                            <input
                              class="field__input"
                              data-price-input
                              type="number"
                              inputmode="decimal"
                              id="Filter-{{ section_id }}-price-lte"
                              name="{{ filter.max_value.param_name }}"
                              {% if filter.max_value.value %}
                                value="{{ max_display }}"
                              {% endif %}
                              placeholder="{{ range_max }}"
                              min="0"
                              max="{{ range_max }}"
                            >
                          </div>
                        </div>
                        {%- assign range_max_money = filter.range_max | money -%}
                        <p class="facet__hint">{{ 'products.facets.max_price' | t: price: range_max_money }}</p>
                      {%- else -%}
                        <ul class="facet__list" role="list">
                          {%- for value in filter.values -%}
                            {%- liquid
                              assign input_id = 'Filter-' | append: section_id | append: '-' | append: filter_key | append: '-' | append: forloop.index
                              assign is_disabled = false
                              if value.count == 0 and value.active == false
                                assign is_disabled = true
                              endif
                            -%}
                            <li>
                              <label class="checkbox facet__option{% if is_disabled %} is-disabled{% endif %}" for="{{ input_id }}">
                                <input
                                  type="checkbox"
                                  id="{{ input_id }}"
                                  name="{{ value.param_name }}"
                                  value="{{ value.value }}"
                                  {% if value.active %}
                                    checked
                                  {% endif %}
                                  {% if is_disabled %}
                                    disabled
                                  {% endif %}
                                >
                                {%- if value.swatch.color -%}
                                  <span class="facet__swatch" style="background-color: {{ value.swatch.color }};" aria-hidden="true"></span>
                                {%- endif -%}
                                <span class="facet__label">{{ value.label | escape }}</span>
                                <span class="facet__count">{{ value.count }}</span>
                              </label>
                            </li>
                          {%- endfor -%}
                        </ul>
                    {%- endcase -%}
                  </div>
                </div>
              </details>
            {%- endfor -%}
            <noscript><button type="submit" class="button button--full gap-top">{{ 'products.facets.apply' | t }}</button></noscript>
          </form>
        </div>
        <div class="drawer__footer facets-drawer__footer">
          <a href="{{ clear_url }}" class="button button--secondary" data-facet-link>{{ 'products.facets.clear_all' | t }}</a>
          <button type="button" class="button" data-drawer-close>
            <span data-facets-render="drawer-count-{{ section_id }}">{{ 'products.facets.show_results' | t: count: product_count }}</span>
          </button>
        </div>
      </div>
    </side-drawer>
  </facet-filters>
{%- endif -%}
