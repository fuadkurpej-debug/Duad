{%- comment -%}
  One cart line (drawer and cart page). Params: item, index, context ('drawer' | 'page')
{%- endcomment -%}
{%- liquid
  assign context = context | default: 'drawer'
  assign rule = item.variant.quantity_rule
  assign step = rule.increment | default: 1
-%}
<li class="cart-item" data-line-item id="CartItem-{{ context }}-{{ index }}">
  <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '120, 200, 300', sizes: '6rem', alt: '' }}
    {%- else -%}
      {%- render 'placeholder-product', product: item.product, index: index -%}
    {%- endif -%}
  </a>

  <div class="cart-item__details">
    <div class="cart-item__top">
      <div>
        {%- if settings.card_show_vendor -%}
          {%- capture display_vendor -%}{%- render 'product-vendor', product: item.product, vendor: item.vendor -%}{%- endcapture -%}
          {%- if display_vendor != blank -%}
            <p class="cart-item__vendor">{{ display_vendor }}</p>
          {%- endif -%}
        {%- endif -%}
        <h3 class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>
        <ul class="cart-item__options" role="list">
          {%- unless item.product.has_only_default_variant -%}
            {%- for option in item.options_with_values -%}
              <li>{{ option.name | escape }}: {{ option.value | escape }}</li>
            {%- endfor -%}
          {%- endunless -%}
          {%- for property in item.properties -%}
            {%- assign first_char = property.first | slice: 0 -%}
            {%- if property.last != blank and first_char != '_' -%}
              <li>{{ property.first | escape }}: {{ property.last | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
          {%- if item.selling_plan_allocation -%}
            <li>{{ item.selling_plan_allocation.selling_plan.name | escape }}</li>
          {%- endif -%}
        </ul>
      </div>
      <div class="cart-item__price">
        {%- if item.original_line_price != item.final_line_price -%}
          <s><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>{{ item.original_line_price | money }}</s>
        {%- endif -%}
        <span>{{ item.final_line_price | money }}</span>
      </div>
    </div>

    {%- if item.line_level_discount_allocations.size > 0 -%}
      <ul class="cart-item__discounts" role="list">
        {%- for discount in item.line_level_discount_allocations -%}
          <li>{{ discount.discount_application.title | escape }} (&minus;{{ discount.amount | money }})</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="cart-item__bottom">
      <quantity-input class="quantity quantity--small">
        <button type="button" class="quantity__button" data-quantity="minus" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}">
          {%- render 'icon', icon: 'minus' -%}
        </button>
        <input
          class="quantity__input"
          type="number"
          name="updates[]"
          id="Quantity-{{ context }}-{{ index }}"
          value="{{ item.quantity }}"
          min="0"
          step="{{ step }}"
          {% if rule.max != null %}
            max="{{ rule.max }}"
          {% endif %}
          inputmode="numeric"
          aria-label="{{ 'cart.quantity_for' | t: title: item.product.title | escape }}"
          data-line-quantity
          data-key="{{ item.key }}"
          data-focus-key="qty-{{ item.key }}"
        >
        <button type="button" class="quantity__button" data-quantity="plus" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}">
          {%- render 'icon', icon: 'plus' -%}
        </button>
      </quantity-input>
      <button
        type="button"
        class="cart-item__remove"
        data-line-remove
        data-key="{{ item.key }}"
        data-focus-key="remove-{{ item.key }}"
        aria-label="{{ 'cart.remove_title' | t: title: item.product.title | escape }}"
      >
        {{- 'cart.remove' | t -}}
      </button>
    </div>
  </div>
</li>
