{%- comment -%}
  Product rating from the standard reviews metafields that review apps write
  (reviews.rating / reviews.rating_count). Nothing renders without real data.
  Params: product, class, link (optional anchor href)
{%- endcomment -%}
{%- assign rating_field = product.metafields.reviews.rating -%}
{%- if rating_field != blank and rating_field.value != blank -%}
  {%- liquid
    assign rating_value = rating_field.value.rating | round: 1
    assign scale_max = rating_field.value.scale_max | default: 5
    assign percent = rating_field.value.rating | times: 100.0 | divided_by: scale_max | round: 1
    assign review_count = product.metafields.reviews.rating_count.value | default: 0
  -%}
  {%- if link -%}<a href="{{ link }}" class="rating{% if class %} {{ class }}{% endif %}">{%- else -%}<div class="rating{% if class %} {{ class }}{% endif %}">{%- endif -%}
    <span class="rating__stars" style="--percent: {{ percent }}%;" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: scale_max }}"></span>
    {%- if review_count > 0 -%}
      <span aria-hidden="true">({{ review_count }})</span>
      <span class="visually-hidden">{{ 'accessibility.total_reviews' | t: count: review_count }}</span>
    {%- endif -%}
  {%- if link -%}</a>{%- else -%}</div>{%- endif -%}
{%- endif -%}
