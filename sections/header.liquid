{%- assign brand_text = settings.brand_name | default: shop.name -%}
{%- liquid
  assign menu = section.settings.menu
  assign logo_alt = section.settings.logo.alt | default: brand_text | escape
  assign shop_name_html = brand_text | escape | replace: '&amp;', '<span class="logo-amp">&amp;</span>'
  assign cart_is_drawer = false
  if settings.cart_type == 'drawer' and template.name != 'cart'
    assign cart_is_drawer = true
  endif

  # Rough width of the desktop menu, so a menu that cannot sit beside a centred logo starts on its own row (theme.js refines it)
  assign nav_width = 0
  for link in menu.links
    assign link_width = link.title.size | times: 10.5
    if link.links.size > 0
      assign link_width = link_width | plus: 24
    endif
    assign nav_width = nav_width | plus: link_width | plus: 32
  endfor
  assign header_stacked = false
  if section.settings.logo_position != 'left' and nav_width > 600
    assign header_stacked = true
  endif
-%}

<site-header
  role="banner"
  class="header header--logo-{{ section.settings.logo_position }}{% if header_stacked %} header--stacked{% endif %} color-{{ section.settings.color_scheme }}"
  data-sticky="{{ section.settings.sticky }}"
  style="--logo-width: {{ section.settings.logo_width }}px; --logo-width-mobile: {{ section.settings.logo_width_mobile }}px;"
>
  <div class="page-width header__inner">
    <div class="header__start">
      <button
        type="button"
        class="icon-button header__menu-toggle"
        data-drawer-open="MenuDrawer"
        aria-controls="MenuDrawer"
        aria-expanded="false"
        aria-label="{{ 'header.menu' | t }}"
      >
        {%- render 'icon', icon: 'menu' -%}
      </button>
      <button
        type="button"
        class="icon-button header__search-mobile"
        data-drawer-open="SearchDrawer"
        aria-controls="SearchDrawer"
        aria-expanded="false"
        aria-label="{{ 'header.search' | t }}"
      >
        {%- render 'icon', icon: 'search' -%}
      </button>
    </div>

    <div class="header__logo">
      <a href="{{ routes.root_url }}" class="header__logo-link">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 600
            | image_tag:
              class: 'header__logo-image',
              widths: '150, 225, 300, 450, 600',
              sizes: '(min-width: 990px) 200px, 140px',
              loading: 'eager',
              alt: logo_alt
          }}
        {%- else -%}
          <span class="logo-text">{{ shop_name_html }}</span>
        {%- endif -%}
      </a>
    </div>

    <nav class="header__nav" aria-label="{{ 'header.main_navigation' | t }}">
      {%- if menu != blank -%}
        <ul class="menu" role="list">
          {%- for link in menu.links -%}
            {%- if link.type == 'collection_link' and link.object.all_products_count == 0 and request.design_mode == false -%}{%- continue -%}{%- endif -%}
            {%- assign has_children = false -%}
            {%- if link.links.size > 0 -%}{%- assign has_children = true -%}{%- endif -%}
            <li class="menu__item{% if has_children %} has-dropdown{% endif %}">
              <div class="menu__link-wrap">
                <a href="{{ link.url }}" class="menu__link"{% if link.current %} aria-current="page"{% endif %}>
                  {{- link.title | escape -}}
                </a>
                {%- if has_children -%}
                  <button
                    type="button"
                    class="menu__toggle"
                    data-submenu-toggle
                    aria-expanded="false"
                    aria-controls="Mega-{{ section.id }}-{{ forloop.index }}"
                    aria-label="{{ 'header.submenu_toggle' | t: title: link.title | escape }}"
                  >
                    {%- render 'icon', icon: 'chevron-down' -%}
                  </button>
                {%- endif -%}
              </div>
              {%- if has_children -%}
                {%- liquid
                  assign link_title = link.title | downcase | strip
                -%}
                {%- capture promos -%}
                  {%- for block in section.blocks -%}
                    {%- assign target = block.settings.menu_item | downcase | strip -%}
                    {%- if block.type == 'mega_promo' and target == link_title -%}
                      <a class="mega-promo" href="{{ block.settings.link | default: link.url }}" {{ block.shopify_attributes }}>
                        <div class="media">
                          {%- if block.settings.image != blank -%}
                            {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '240px', alt: '' }}
                          {%- else -%}
                            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                          {%- endif -%}
                        </div>
                        {%- if block.settings.label != blank -%}
                          <span class="mega-promo__label">{{ block.settings.label | escape }}</span>
                        {%- endif -%}
                        {%- if block.settings.heading != blank -%}
                          <span class="mega-promo__title">{{ block.settings.heading | escape }}</span>
                        {%- endif -%}
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endcapture -%}
                <div class="mega color-{{ section.settings.color_scheme }}" id="Mega-{{ section.id }}-{{ forloop.index }}">
                  <div class="page-width mega__inner">
                    <div class="mega__columns">
                      {%- for child in link.links -%}
                        {%- if child.type == 'collection_link' and child.object.all_products_count == 0 and request.design_mode == false -%}{%- continue -%}{%- endif -%}
                        <div class="mega__column">
                          <a class="mega__heading" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                          {%- if child.links.size > 0 -%}
                            <ul class="mega__list" role="list">
                              {%- for grandchild in child.links -%}
                                <li><a href="{{ grandchild.url }}"{% if grandchild.current %} aria-current="page"{% endif %}>{{ grandchild.title | escape }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                      <div class="mega__column">
                        <a class="link" href="{{ link.url }}">{%- assign view_all_down = link.title | downcase -%}{%- if view_all_down contains 'shop' -%}{{ 'header.view_all_plain' | t }}{%- else -%}{{ 'header.view_all' | t: title: link.title | escape }}{%- endif -%} {% render 'icon', icon: 'arrow-right' %}</a>
                      </div>
                    </div>
                    {%- if promos != blank -%}
                      <div class="mega__promo">{{ promos }}</div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </nav>

    <div class="header__icons">
      <button
        type="button"
        class="icon-button header__search-desktop"
        data-drawer-open="SearchDrawer"
        aria-controls="SearchDrawer"
        aria-expanded="false"
        aria-label="{{ 'header.search' | t }}"
      >
        {%- render 'icon', icon: 'search' -%}
      </button>
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="icon-button header__account"
          aria-label="{% if customer %}{{ 'header.account' | t }}{% else %}{{ 'header.login' | t }}{% endif %}"
        >
          {%- render 'icon', icon: 'account' -%}
        </a>
      {%- endif -%}
      <a
        href="{{ routes.cart_url }}"
        class="icon-button cart-toggle"
        id="CartToggle"
        {% if cart_is_drawer %}
          data-drawer-open="CartDrawer" aria-controls="CartDrawer" aria-expanded="false"
        {% endif %}
        aria-label="{{ 'header.cart' | t }}"
      >
        {%- render 'icon', icon: 'bag' -%}
        <span class="cart-count" data-cart-render="cart-count">
          {%- if cart.item_count > 0 -%}
            <span aria-hidden="true">{{ cart.item_count }}</span><span class="visually-hidden">{{ 'header.cart_count' | t: count: cart.item_count }}</span>
          {%- endif -%}
        </span>
      </a>
    </div>
  </div>
</site-header>

<side-drawer
  id="MenuDrawer"
  class="drawer drawer--left menu-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'header.menu' | t }}"
  aria-hidden="true"
>
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel color-{{ section.settings.color_scheme }}" tabindex="-1">
    <div class="drawer__header">
      <span class="logo-text">{{ shop_name_html }}</span>
      <button type="button" class="icon-button" data-drawer-close aria-label="{{ 'header.close_menu' | t }}">
        {%- render 'icon', icon: 'close' -%}
      </button>
    </div>
    <div class="drawer__body">
      {%- if menu != blank -%}
        <nav aria-label="{{ 'header.main_navigation' | t }}">
          <ul class="menu-drawer__nav" role="list">
            {%- for link in menu.links -%}
              {%- if link.type == 'collection_link' and link.object.all_products_count == 0 and request.design_mode == false -%}{%- continue -%}{%- endif -%}
              <li class="menu-drawer__item">
                {%- if link.links.size > 0 -%}
                  <details data-accordion data-accordion-group="menu-drawer">
                    <summary>
                      <span>{{ link.title | escape }}</span>
                      {%- render 'icon', icon: 'plus' -%}
                    </summary>
                    <div data-accordion-content>
                      <ul class="menu-drawer__sub" role="list">
                        <li><a href="{{ link.url }}">{%- assign view_all_down = link.title | downcase -%}{%- if view_all_down contains 'shop' -%}{{ 'header.view_all_plain' | t }}{%- else -%}{{ 'header.view_all' | t: title: link.title | escape }}{%- endif -%}</a></li>
                        {%- for child in link.links -%}
                          {%- if child.type == 'collection_link' and child.object.all_products_count == 0 and request.design_mode == false -%}{%- continue -%}{%- endif -%}
                          <li>
                            <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                            {%- if child.links.size > 0 -%}
                              <ul class="menu-drawer__sub" role="list">
                                {%- for grandchild in child.links -%}
                                  <li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </details>
                {%- else -%}
                  <a href="{{ link.url }}" class="menu-drawer__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      <div class="menu-drawer__secondary">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
            {%- render 'icon', icon: 'account' -%}
            <span>{% if customer %}{{ 'header.account' | t }}{% else %}{{ 'header.login' | t }}{% endif %}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.contact_link != blank -%}
          <a href="{{ section.settings.contact_link }}">
            {%- render 'icon', icon: 'chat' -%}
            <span>{{ 'header.contact' | t }}</span>
          </a>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'mega_promo' and block.settings.show_in_drawer -%}
          <div class="menu-drawer__promo">
            <a class="mega-promo" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
              <div class="media media--landscape">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '90vw', alt: '' }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              {%- if block.settings.label != blank -%}<span class="mega-promo__label">{{ block.settings.label | escape }}</span>{%- endif -%}
              {%- if block.settings.heading != blank -%}<span class="mega-promo__title">{{ block.settings.heading | escape }}</span>{%- endif -%}
            </a>
          </div>
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- render 'social-icons' -%}
    </div>
  </div>
</side-drawer>

{%- if request.page_type == 'index' -%}
  {%- liquid
    assign search_target = request.origin | append: routes.search_url | append: '?q={search_term_string}'
    assign social_links = settings.social_instagram_link | append: '|' | append: settings.social_tiktok_link | append: '|' | append: settings.social_pinterest_link | append: '|' | append: settings.social_facebook_link | append: '|' | append: settings.social_youtube_link | append: '|' | append: settings.social_twitter_link | split: '|'
    assign first_link = true
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ brand_text | json }},
      {%- if section.settings.logo != blank %}
      "logo": {{ section.settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
      {%- elsif settings.favicon != blank %}
      "logo": {{ settings.favicon | image_url: width: 512, height: 512 | prepend: 'https:' | json }},
      {%- endif %}
      "sameAs": [
        {%- for social in social_links -%}
          {%- if social != blank -%}
            {%- unless first_link -%},{%- endunless -%}
            {{ social | json }}
            {%- assign first_link = false -%}
          {%- endif -%}
        {%- endfor -%}
      ],
      "url": {{ request.origin | append: routes.root_url | json }}
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ brand_text | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ search_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: routes.root_url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "tag": "div",
  "class": "header-section",
  "max_blocks": 6,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Leave empty to show the store name as an elegant wordmark."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Logo width on desktop",
      "default": 160
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 60,
      "max": 220,
      "step": 5,
      "unit": "px",
      "label": "Logo width on mobile",
      "default": 120
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position on desktop",
      "options": [
        { "value": "center", "label": "Center (menu on the left)" },
        { "value": "left", "label": "Left (menu in the middle)" }
      ],
      "default": "center",
      "info": "With a centered logo, a menu too long to fit beside it moves to its own row below the logo."
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Second-level links open as an elegant dropdown with optional image promos (add a Menu promo block). Links to collections without products are hidden on your store until products are added."
    },
    {
      "type": "select",
      "id": "sticky",
      "label": "Sticky header",
      "options": [
        { "value": "none", "label": "Off" },
        { "value": "always", "label": "Always" },
        { "value": "scroll-up", "label": "Show when scrolling up" }
      ],
      "default": "always"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link in mobile menu"
    }
  ],
  "blocks": [
    {
      "type": "mega_promo",
      "name": "Menu promo",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Show under menu item",
          "info": "Type the menu item title exactly, e.g. Skincare."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Small label",
          "default": "Discover"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Build your ritual"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "show_in_drawer",
          "label": "Also show in mobile menu",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
