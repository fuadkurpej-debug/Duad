{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100 | round
  assign slide_count = 0
-%}
{%- capture slides -%}
  {%- for block in section.blocks -%}
    {%- assign text = block.settings.text -%}
    {%- if block.type == 'free_shipping' -%}
      {%- if threshold <= 0 or cart.currency.iso_code != shop.currency -%}
        {%- continue -%}
      {%- endif -%}
      {%- assign threshold_money = threshold | money_without_trailing_zeros -%}
      {%- assign text = block.settings.text | replace: '[amount]', threshold_money -%}
    {%- endif -%}
    {%- if text == blank -%}{%- continue -%}{%- endif -%}
    {%- assign slide_count = slide_count | plus: 1 -%}
    <p
      class="announcement-bar__slide{% if slide_count == 1 %} is-active{% endif %}"
      data-announcement
      aria-hidden="{% if slide_count == 1 %}false{% else %}true{% endif %}"
      {{ block.shopify_attributes }}
    >
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}">{{ text }}</a>
      {%- else -%}
        {{ text }}
      {%- endif -%}
    </p>
  {%- endfor -%}
{%- endcapture -%}

{%- if slide_count > 0 -%}
  <announcement-bar
    class="announcement-bar color-{{ section.settings.color_scheme }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.speed }}"
    role="region"
    aria-label="{{ 'sections.announcement.label' | t }}"
  >
    <div class="page-width announcement-bar__inner">
      <span>
        {%- if slide_count > 1 -%}
          <button type="button" class="announcement-bar__nav" data-announcement-nav="prev" aria-label="{{ 'accessibility.previous_slide' | t }}">
            {%- render 'icon', icon: 'chevron-left' -%}
          </button>
        {%- endif -%}
      </span>
      <div class="announcement-bar__slides">{{ slides }}</div>
      <span>
        {%- if slide_count > 1 -%}
          <button type="button" class="announcement-bar__nav" data-announcement-nav="next" aria-label="{{ 'accessibility.next_slide' | t }}">
            {%- render 'icon', icon: 'chevron-right' -%}
          </button>
        {%- endif -%}
      </span>
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "div",
  "class": "announcement-bar-section",
  "max_blocks": 6,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotate announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change every",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Considered skincare, curated with care"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "free_shipping",
      "name": "Free shipping message",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Uses the free shipping threshold from Theme settings → Cart. Write [amount] where the amount should appear. Hidden automatically when the threshold is 0 or the visitor shops in another currency."
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Complimentary shipping on orders over [amount]"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "free_shipping" },
        { "type": "announcement" }
      ]
    }
  ]
}
{% endschema %}
