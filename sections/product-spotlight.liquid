{%- liquid
  assign product = section.settings.product
  assign current_variant = product.selected_or_first_available_variant
  assign image = section.settings.image | default: product.featured_media.preview_image
  assign form_id = 'SpotlightForm-' | append: section.id
  case section.settings.image_ratio
    when 'portrait'
      assign ratio_css = '4 / 5'
    when 'landscape'
      assign ratio_css = '5 / 4'
    else
      assign ratio_css = '1 / 1'
  endcase
  assign own_vendor = settings.own_brand_vendor | downcase | strip
  assign vendor_down = product.vendor | downcase | strip
  assign heading = section.settings.heading
  if heading == blank
    assign heading = product.title | escape
  endif
  if heading == blank
    assign heading = 'sections.spotlight.placeholder_title' | t
  endif
-%}
{%- comment -%} Without an available product the section only shows in the Theme Editor, never as a half-filled placeholder {%- endcomment -%}
{%- if product != blank or request.design_mode -%}
<div class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="spotlight{% if section.settings.layout == 'image_right' %} spotlight--reverse{% endif %}" data-product-scope>
      <div class="spotlight__media-wrap" data-reveal>
        <div class="media spotlight__media" style="--spotlight-ratio: {{ ratio_css }};">
          {%- if image != blank -%}
            {%- assign image_alt = image.alt | default: heading | strip_html | escape -%}
            {{ image | image_url: width: 1800 | image_tag: widths: '500, 750, 1000, 1300, 1600, 1800', sizes: '(min-width: 990px) 52vw, 100vw', loading: 'lazy', alt: image_alt }}
          {%- else -%}
            {%- render 'placeholder-product', product: product, index: section.id -%}
          {%- endif -%}
        </div>
        {%- if section.settings.seal_text != blank -%}
          <div class="spotlight__seal" aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <defs>
                <path id="SealPath-{{ section.id }}" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"></path>
              </defs>
              <text font-size="9" letter-spacing="2.6" fill="currentColor" style="font-family: var(--font-body-family); text-transform: uppercase;">
                <textPath href="#SealPath-{{ section.id }}">{{ section.settings.seal_text | escape }} · {{ section.settings.seal_text | escape }} ·</textPath>
              </text>
            </svg>
            {%- render 'icon', icon: 'sparkle' -%}
          </div>
        {%- endif -%}
      </div>

      <div class="spotlight__content" data-reveal style="--reveal-order: 1;">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow eyebrow--line">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.show_vendor and product != blank -%}
          {%- capture display_vendor -%}{%- render 'product-vendor', product: product -%}{%- endcapture -%}
          {%- if own_vendor != blank and vendor_down == own_vendor -%}
            <p class="spotlight__vendor">{{ settings.badge_own_label | escape }}</p>
          {%- elsif display_vendor != blank -%}
            <p class="spotlight__vendor">{{ 'products.product.made_by' | t: vendor: display_vendor }}</p>
          {%- endif -%}
        {%- endif -%}
        <h2 class="h1">{{ heading }}</h2>
        {%- if product != blank -%}
          {%- render 'rating', product: product, link: product.url -%}
        {%- endif -%}

        <div class="spotlight__description rte">
          {%- if section.settings.description != blank -%}
            {{ section.settings.description }}
          {%- elsif product.description != blank -%}
            <p>{{ product.description | strip_html | truncatewords: 38 }}</p>
          {%- endif -%}
        </div>

        {%- capture benefit_items -%}
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <span class="check-list__icon">{% render 'icon', icon: 'check' %}</span>
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endfor -%}
          {%- if section.blocks.size == 0 and product.metafields.custom.benefits != blank -%}
            {%- for benefit in product.metafields.custom.benefits.value limit: 4 -%}
              <li>
                <span class="check-list__icon">{% render 'icon', icon: 'check' %}</span>
                <span>{{ benefit | escape }}</span>
              </li>
            {%- endfor -%}
          {%- endif -%}
        {%- endcapture -%}
        {%- if benefit_items != blank -%}
          <ul class="check-list" role="list">{{ benefit_items }}</ul>
        {%- endif -%}

        {%- if product != blank -%}
          {%- if section.settings.show_price -%}
            <div data-variant-slot="price">
              {%- render 'price', product: product, variant: current_variant, class: 'price--large', show_lowest: true -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_buy and product.available -%}
            <div class="spotlight__form">
              {%- render 'variant-picker', product: product, section_id: section.id, style: 'dropdown', update_url: false -%}
              <product-form>
                {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input="{{ section.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <div class="spotlight__actions">
                    <button
                      type="submit"
                      name="add"
                      class="button button--large"
                      data-atc="{{ section.id }}"
                      {% unless current_variant.available %}
                        disabled
                      {% endunless %}
                    >
                      <span data-atc-label>
                        {%- if current_variant.available -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </span>
                    </button>
                    <a href="{{ product.url }}" class="link">{{ 'products.product.view_details' | t }} {% render 'icon', icon: 'arrow-right' %}</a>
                  </div>
                  <div class="form-message form-message--error" data-form-error role="alert" hidden>
                    {%- render 'icon', icon: 'info' -%}<span data-form-error-text></span>
                  </div>
                {%- endform -%}
              </product-form>
            </div>
          {%- else -%}
            <div class="spotlight__actions">
              <a href="{{ product.url }}" class="button button--large">{{ 'products.product.view_details' | t }}</a>
            </div>
          {%- endif -%}

          {%- unless product.has_only_default_variant -%}
            {%- for variant in product.variants -%}
              <template data-variant-template="{{ variant.id }}">
                <div data-slot="price">{%- render 'price', product: product, variant: variant, class: 'price--large', show_lowest: true -%}</div>
              </template>
            {%- endfor -%}
          {%- endunless -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Product spotlight",
  "tag": "section",
  "class": "spotlight-section",
  "max_blocks": 5,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom image",
      "info": "Optional. Uses the product image when empty."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position on desktop",
      "options": [
        { "value": "image_left", "label": "Left" },
        { "value": "image_right", "label": "Right" }
      ],
      "default": "image_left"
    },
    {
      "type": "text",
      "id": "seal_text",
      "label": "Rotating seal text",
      "default": "Skin & Beauty · Signature",
      "info": "Decorative circular badge on the image. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "In the spotlight"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Uses the product title when empty."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "info": "Uses the product description when empty."
    },
    {
      "type": "paragraph",
      "content": "Benefits: add Benefit blocks, or leave empty to use the product metafield custom.benefits. Only list claims you can substantiate."
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show maker",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_buy",
      "label": "Show add to cart",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 104
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 104
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Lightweight, layerable texture"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product spotlight"
    }
  ]
}
{% endschema %}
