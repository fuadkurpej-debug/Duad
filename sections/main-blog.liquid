<div class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <header class="page-header page-header--center" style="padding-top: 0;">
      <p class="eyebrow">{{ 'blogs.journal' | t }}</p>
      <h1 class="h1">{{ blog.title | escape }}</h1>
    </header>
    {%- paginate blog.articles by 9 -%}
      <ul class="grid" style="--cols-desktop: 3; --cols-tablet: 2; --cols-mobile: 1;" role="list">
        {%- for article in blog.articles -%}
          {%- assign order = forloop.index0 | modulo: 3 -%}
          <li data-reveal style="--reveal-order: {{ order }};">
            <article class="category-card">
              <a href="{{ article.url }}" class="category-card__media" style="--category-ratio: 4 / 3;" tabindex="-1" aria-hidden="true">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 100vw', loading: 'lazy', alt: '' }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="category-card__body">
                <p class="card__vendor">{{ article.published_at | time_tag: format: 'date' }}</p>
                <h2 class="category-card__title"><a href="{{ article.url }}" class="full-unstyled-link">{{ article.title | escape }}</a></h2>
                <p class="category-card__text">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "main-blog-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ]
}
{% endschema %}
