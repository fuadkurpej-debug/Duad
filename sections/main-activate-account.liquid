{{ 'customer.css' | asset_url | stylesheet_tag }}
<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width customer customer--narrow">
    <div class="customer__card">
      <h1 class="h2">{{ 'customer.activate_account.title' | t }}</h1>
      <p class="customer__intro">{{ 'customer.activate_account.subtext' | t }}</p>
      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="ActivatePassword">{{ 'customer.login.password' | t }}</label>
          <input class="field__input" type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required>
        </div>
        <div class="field">
          <label class="field__label" for="ActivatePasswordConfirm">{{ 'customer.reset_password.confirm' | t }}</label>
          <input class="field__input" type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required>
        </div>
        <button type="submit" class="button button--full">{{ 'customer.activate_account.submit' | t }}</button>
        <button type="submit" class="button button--secondary button--full" name="decline">{{ 'customer.activate_account.cancel' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Activate account",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
