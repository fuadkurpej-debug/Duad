{%- assign brand_text = settings.brand_name | default: shop.name -%}
{%- liquid
  assign link_cols = 0
  for block in section.blocks
    if block.type == 'link_list' or block.type == 'text' or block.type == 'contact'
      assign link_cols = link_cols | plus: 1
    endif
  endfor
  if link_cols == 0
    assign link_cols = 1
  endif
  assign shop_name_html = brand_text | escape | replace: '&amp;', '<span class="logo-amp">&amp;</span>'
-%}
<footer class="footer color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="footer__top" style="--link-cols: {{ link_cols }};">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="footer-block footer-block__brand" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                {%- assign logo_alt = block.settings.logo.alt | default: brand_text | escape -%}
                {{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '200px', style: 'width: 180px; height: auto;', alt: logo_alt }}
              {%- else -%}
                <p class="logo-text">{{ shop_name_html }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="footer-block__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- render 'social-icons' -%}
            </div>

          {%- when 'link_list' -%}
            <details class="footer-block footer-block--links" data-footer-accordion open {{ block.shopify_attributes }}>
              <summary class="footer-block__heading">
                <span>{{ block.settings.heading | escape }}</span>
                {%- render 'icon', icon: 'plus' -%}
              </summary>
              {%- if block.settings.menu != blank -%}
                <ul class="footer-links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </details>

          {%- when 'text' -%}
            <details class="footer-block footer-block--links" data-footer-accordion open {{ block.shopify_attributes }}>
              <summary class="footer-block__heading">
                <span>{{ block.settings.heading | escape }}</span>
                {%- render 'icon', icon: 'plus' -%}
              </summary>
              <div class="footer-block__text rte">{{ block.settings.text }}</div>
            </details>

          {%- when 'contact' -%}
            <details class="footer-block footer-block--links" data-footer-accordion open {{ block.shopify_attributes }}>
              <summary class="footer-block__heading">
                <span>{{ block.settings.heading | escape }}</span>
                {%- render 'icon', icon: 'plus' -%}
              </summary>
              <ul class="footer-contact" role="list">
                {%- if block.settings.email != blank -%}
                  <li>{% render 'icon', icon: 'mail' %}<a href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email | escape }}</a></li>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <li>{% render 'icon', icon: 'phone' %}<a href="tel:{{ block.settings.phone | remove: ' ' | escape }}">{{ block.settings.phone | escape }}</a></li>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}
                  <li>{% render 'icon', icon: 'clock' %}<span>{{ block.settings.hours | escape }}</span></li>
                {%- endif -%}
                {%- if block.settings.link != blank -%}
                  <li>{% render 'icon', icon: 'chat' %}<a href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a></li>
                {%- endif -%}
              </ul>
            </details>

          {%- when 'newsletter' -%}
            <div class="footer-block footer-block__newsletter" id="FooterNewsletter" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="h4">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="footer-block__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- assign footer_form_id = 'FooterNewsletterForm-' | append: section.id -%}
              {%- form 'customer', id: footer_form_id, class: 'newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="form-message" role="status">{% render 'icon', icon: 'check' %}<span>{{ 'newsletter.success' | t }}</span></p>
                {%- else -%}
                  <div class="newsletter-form__row">
                    <div class="field">
                      <label class="visually-hidden" for="FooterNewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
                      <input
                        id="FooterNewsletterEmail-{{ section.id }}"
                        type="email"
                        name="contact[email]"
                        class="field__input"
                        autocomplete="email"
                        autocorrect="off"
                        autocapitalize="off"
                        placeholder="{{ 'newsletter.placeholder' | t }}"
                        required
                      >
                    </div>
                    <button type="submit" class="button" aria-label="{{ 'newsletter.submit' | t }}">{% render 'icon', icon: 'arrow-right' %}</button>
                  </div>
                  {%- if form.errors -%}
                    <p class="form-message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                  {%- endif -%}
                {%- endif -%}
              {%- endform -%}
              {%- if block.settings.fine_print != blank -%}
                <div class="newsletter__fine-print">{{ block.settings.fine_print }}</div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_wordmark -%}
      <p class="footer__wordmark" aria-hidden="true">{{ shop_name_html }}</p>
    {%- endif -%}

    <div class="footer__bottom">
      <div class="footer__legal">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ brand_text | escape }}.</span>
        {%- if section.settings.show_powered_by %} {{ powered_by_link }}{% endif -%}
      </div>

      {%- if section.settings.show_policies and shop.policies.size > 0 -%}
        <ul class="footer__policies" role="list">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_localization -%}
        {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
          {%- form 'localization', class: 'localization-form' -%}
            {%- if localization.available_countries.size > 1 -%}
              <div class="select">
                <label class="visually-hidden" for="FooterCountry-{{ section.id }}">{{ 'general.localization.country' | t }}</label>
                <select id="FooterCountry-{{ section.id }}" name="country_code" class="select__select" onchange="this.form.submit()">
                  {%- for country in localization.available_countries -%}
                    <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                      {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol -}})
                    </option>
                  {%- endfor -%}
                </select>
                {%- render 'icon', icon: 'chevron-down' -%}
              </div>
            {%- endif -%}
            {%- if localization.available_languages.size > 1 -%}
              <div class="select">
                <label class="visually-hidden" for="FooterLanguage-{{ section.id }}">{{ 'general.localization.language' | t }}</label>
                <select id="FooterLanguage-{{ section.id }}" name="language_code" class="select__select" onchange="this.form.submit()">
                  {%- for language in localization.available_languages -%}
                    <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                      {{- language.endonym_name | capitalize -}}
                    </option>
                  {%- endfor -%}
                </select>
                {%- render 'icon', icon: 'chevron-down' -%}
              </div>
            {%- endif -%}
            <noscript><button type="submit" class="button button--small">{{ 'general.localization.update' | t }}</button></noscript>
          {%- endform -%}
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="payment-icons" role="list" aria-label="{{ 'general.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "footer-section",
  "max_blocks": 8,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show large wordmark",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "default": true,
      "info": "Lists the policies you created in Settings → Policies."
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country and language selectors",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show \"Powered by Shopify\"",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Optional. Light logos work best on the dark footer."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Curated skincare, body and beauty essentials — chosen for beautiful textures, considered formulas and rituals that feel like a pause in your day.</p>"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Customer care",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Customer care"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "info": "Use your real support address."
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Opening hours",
          "info": "Example: Mon–Fri, 9:00–17:00 CET"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Contact page link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Send us a message"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share a short note about your brand.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The Skin & Beauty letter"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Rituals, new arrivals and early access — a few thoughtful emails a month.</p>"
        },
        {
          "type": "richtext",
          "id": "fine_print",
          "label": "Consent note",
          "default": "<p>By subscribing you agree to receive marketing emails. Unsubscribe anytime. See our <a href=\"/policies/privacy-policy\">privacy policy</a>.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "link_list", "settings": { "heading": "Shop", "menu": "footer" } },
        { "type": "contact" },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
