{{ 'customer.css' | asset_url | stylesheet_tag }}
<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width customer customer--narrow">
    <div class="customer__card" id="recover" tabindex="-1">
      <h1 class="h2">{{ 'customer.recover_password.title' | t }}</h1>
      <p class="customer__intro">{{ 'customer.recover_password.subtext' | t }}</p>
      {%- form 'recover_customer_password' -%}
        {%- assign recover_success = form.posted_successfully? -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors.messages.form }}</div>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
          <input class="field__input" type="email" id="RecoverEmail" name="email" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        </div>
        <button type="submit" class="button button--full">{{ 'customer.recover_password.submit' | t }}</button>
        <a href="#login" class="link">{{ 'customer.recover_password.cancel' | t }}</a>
      {%- endform -%}
    </div>

    <div class="customer__card" id="login">
      <h1 class="h2">{{ 'customer.login.title' | t }}</h1>
      {%- if recover_success -%}
        <p class="form-message" role="status">{% render 'icon', icon: 'check' %}<span>{{ 'customer.recover_password.success' | t }}</span></p>
      {%- endif -%}
      {%- form 'customer_login', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="CustomerEmail">{{ 'customer.login.email' | t }}</label>
          <input class="field__input" type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        </div>
        {%- if form.password_needed -%}
          <div class="field">
            <label class="field__label" for="CustomerPassword">{{ 'customer.login.password' | t }}</label>
            <input class="field__input" type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required>
          </div>
        {%- endif -%}
        <button type="submit" class="button button--full">{{ 'customer.login.sign_in' | t }}</button>
        <div class="customer__links">
          {%- if form.password_needed -%}
            <a href="#recover" class="link">{{ 'customer.login.forgot_password' | t }}</a>
          {%- endif -%}
          <a href="{{ routes.account_register_url }}" class="link">{{ 'customer.login.create_account' | t }}</a>
        </div>
      {%- endform -%}

      {%- if shop.checkout.guest_login -%}
        <p class="customer__divider">{{ 'customer.login.or' | t }}</p>
        {%- form 'guest_login' -%}
          <button type="submit" class="button button--secondary button--full">{{ 'customer.login.guest_continue' | t }}</button>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer login",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
