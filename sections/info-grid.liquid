<div class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      align: section.settings.heading_alignment
    -%}
    <ul class="info-grid" style="--cols: {{ section.settings.columns }};" role="list">
      {%- for block in section.blocks -%}
        {%- assign order = forloop.index0 | modulo: 3 -%}
        <li class="info-card" {{ block.shopify_attributes }} data-reveal style="--reveal-order: {{ order }};">
          {%- if block.settings.icon != 'none' -%}
            <span class="info-card__icon" aria-hidden="true">{%- render 'icon', icon: block.settings.icon -%}</span>
          {%- endif -%}
          {%- if block.settings.kicker != blank -%}
            <p class="info-card__kicker">{{ block.settings.kicker | escape }}</p>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="info-card__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="info-card__text rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Info cards",
  "tag": "section",
  "class": "info-grid-section",
  "max_blocks": 9,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What to expect"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "package", "label": "Package" },
            { "value": "return", "label": "Returns" },
            { "value": "globe", "label": "Globe" },
            { "value": "clock", "label": "Clock" },
            { "value": "chat", "label": "Chat" },
            { "value": "mail", "label": "Mail" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "flask", "label": "Formula" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" },
            { "value": "lock", "label": "Lock" },
            { "value": "gift", "label": "Gift" },
            { "value": "layers", "label": "Layers" }
          ],
          "default": "sparkle"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Small label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Card title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add helpful details here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Info cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
