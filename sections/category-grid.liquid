{%- liquid
  case section.settings.image_ratio
    when 'square'
      assign ratio_css = '1 / 1'
    when 'tall'
      assign ratio_css = '3 / 4'
    else
      assign ratio_css = '4 / 5'
  endcase
  assign columns = section.settings.columns_desktop
  assign card_sizes = '(min-width: 1440px) 300px, (min-width: 990px) calc((100vw - 10rem) / ' | append: columns | append: '), (min-width: 750px) 42vw, 74vw'
-%}
<div class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- capture actions -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: routes.collections_url }}" class="link">{{ section.settings.link_label | escape }} {% render 'icon', icon: 'arrow-right' %}</a>
      {%- endif -%}
    {%- endcapture -%}
    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.text,
      align: section.settings.heading_alignment,
      actions: actions
    -%}

    <ul
      class="category-list {% if section.settings.mobile_layout == 'slider' %}slider slider--desktop-grid{% else %}grid{% endif %}"
      style="--cols-desktop: {{ columns }}; --cols-tablet: 3; --cols-mobile: 2; --category-ratio: {{ ratio_css }};"
      role="list"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign title = block.settings.title | default: collection.title
          if title == blank
            assign title = 'sections.category_grid.placeholder' | t
          endif
          assign url = block.settings.link | default: collection.url | default: routes.all_products_collection_url
          assign image = block.settings.image | default: collection.featured_image
          assign alt = title | escape
          assign order = forloop.index0 | modulo: 5
        -%}
        <li {{ block.shopify_attributes }} data-reveal style="--reveal-order: {{ order }};">
          <a href="{{ url }}" class="category-card category-card--{{ section.settings.text_style }}">
            <div class="category-card__media">
              {%- if image != blank -%}
                {{ image | image_url: width: 1000 | image_tag: widths: '300, 450, 600, 800, 1000', sizes: card_sizes, loading: 'lazy', alt: alt }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="category-card__body">
              <h3 class="category-card__title">
                <span>{{ title | escape }}</span>
                <span class="category-card__arrow" aria-hidden="true">{% render 'icon', icon: 'arrow-right' %}</span>
              </h3>
              {%- if block.settings.text != blank -%}
                <p class="category-card__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "class": "category-grid-section",
  "max_blocks": 8,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Find your step"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by <em>ritual</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 5
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "portrait", "label": "Portrait" },
        { "value": "tall", "label": "Tall" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Title position",
      "options": [
        { "value": "below", "label": "Below image" },
        { "value": "overlay", "label": "On image" }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "slider", "label": "Swipe" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "slider"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Uses the collection image when empty."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Optional. Uses the collection title when empty."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Optional. Overrides the collection link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "category", "settings": { "title": "Facial Cleansers", "text": "Start fresh" } },
        { "type": "category", "settings": { "title": "Serums", "text": "Targeted care" } },
        { "type": "category", "settings": { "title": "Moisturizers", "text": "Lasting comfort" } },
        { "type": "category", "settings": { "title": "Face Masks", "text": "Your weekly reset" } },
        { "type": "category", "settings": { "title": "Beauty Essentials", "text": "Finishing touches" } }
      ]
    }
  ]
}
{% endschema %}
