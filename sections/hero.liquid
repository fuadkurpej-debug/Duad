{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.image_mobile | default: section.settings.image

  assign position = section.settings.desktop_position | split: '-'
  assign pos_y = position[0]
  assign pos_x = position[1]

  case pos_y
    when 'top'
      assign align_y = 'flex-start'
    when 'bottom'
      assign align_y = 'flex-end'
    else
      assign align_y = 'center'
  endcase

  case pos_x
    when 'center'
      assign align_x = 'center'
      assign text_align = 'center'
      assign buttons_justify = 'center'
      assign overlay_direction = '0deg'
    when 'right'
      assign align_x = 'flex-end'
      assign text_align = 'right'
      assign buttons_justify = 'flex-end'
      assign overlay_direction = '270deg'
    else
      assign align_x = 'flex-start'
      assign text_align = 'left'
      assign buttons_justify = 'flex-start'
      assign overlay_direction = '90deg'
  endcase

  if section.settings.mobile_text_alignment == 'center'
    assign text_align_mobile = 'center'
    assign buttons_justify_mobile = 'center'
  else
    assign text_align_mobile = 'left'
    assign buttons_justify_mobile = 'flex-start'
  endif

  assign loading = 'lazy'
  assign priority = 'auto'
  if section.index == 1
    assign loading = 'eager'
    assign priority = 'high'
  endif

  assign heading_tag = 'h2'
  if section.index == 1 and section.location == 'template'
    assign heading_tag = 'h1'
  endif

  assign img_alt = desktop_image.alt | default: section.settings.heading | strip_html | escape
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0

  assign ratio_desktop = '16 / 9'
  assign ratio_mobile = '4 / 5'
  if desktop_image
    assign ratio_desktop = desktop_image.aspect_ratio
  endif
  if mobile_image
    assign ratio_mobile = mobile_image.aspect_ratio
  endif
-%}

<section
  class="hero hero--{{ section.settings.height }} hero--mobile-{{ section.settings.mobile_layout }}{% if section.settings.image_mobile != blank and section.settings.mobile_layout == 'bottom' %} hero--mobile-fit{% endif %}{% if section.settings.mobile_compact %} hero--mobile-compact{% endif %} color-{{ section.settings.color_scheme }}"
  style="--align-x: {{ align_x }}; --align-y: {{ align_y }}; --text-align: {{ text_align }}; --text-align-mobile: {{ text_align_mobile }}; --buttons-justify: {{ buttons_justify }}; --buttons-justify-mobile: {{ buttons_justify_mobile }}; --overlay-opacity: {{ overlay }}; --overlay-direction: {{ overlay_direction }}; --ratio-desktop: {{ ratio_desktop }}; --mobile-ratio: {{ ratio_mobile }};"
  {% if section.settings.heading != blank %}
    aria-labelledby="HeroHeading-{{ section.id }}"
  {% endif %}
>
  <div class="hero__media{% if section.settings.animate %} hero__media--animate{% endif %}">
    {%- if desktop_image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 900 }} 900w, {{ mobile_image | image_url: width: 1200 }} 1200w, {{ mobile_image | image_url: width: 1600 }} 1600w"
            sizes="100vw"
            width="{{ mobile_image.width }}"
            height="{{ mobile_image.height }}"
          >
        {%- endif -%}
        {{
          desktop_image
          | image_url: width: 3200
          | image_tag:
            widths: '750, 1100, 1500, 1800, 2200, 2600, 3200',
            sizes: '100vw',
            loading: loading,
            fetchpriority: priority,
            alt: img_alt
        }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  {%- if section.settings.overlay_style != 'none' and section.settings.overlay_opacity > 0 -%}
    <div class="hero__overlay{% if section.settings.overlay_style == 'gradient' %} hero__overlay--gradient{% endif %}" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hero__content page-width">
    <div class="hero__box hero__box--x-{{ pos_x }} hero__box--m-{{ text_align_mobile }}{% if section.settings.boxed %} hero__box--boxed{% endif %}{% if section.settings.animate %} hero__box--animate{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="hero__heading {{ section.settings.heading_size }}" id="HeroHeading-{{ section.id }}">
          {{- section.settings.heading -}}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="hero__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="button-group">
          {%- if section.settings.button_label_1 != blank -%}
            <a href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}" class="button button--large{% if section.settings.button_style_1 != 'primary' %} button--{{ section.settings.button_style_1 }}{% endif %}">
              {{- section.settings.button_label_1 | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 | default: routes.all_products_collection_url }}" class="button button--large hero__button-secondary{% if section.settings.button_style_2 != 'primary' %} button--{{ section.settings.button_style_2 }}{% endif %}">
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_scroll_cue -%}
    <span class="hero__scroll" aria-hidden="true">{{ 'sections.hero.scroll' | t }}</span>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "div",
  "class": "hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Landscape, at least 2400px wide. Set a focal point to control cropping."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Portrait works best. With text over the image, the hero takes this image's shape on phones, up to the height of the first screen."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" },
        { "value": "adapt", "label": "Adapt to image" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Animate on load",
      "default": true
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Style",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Solid" },
        { "value": "gradient", "label": "Soft gradient behind text" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Opacity",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "The Skin & Beauty ritual"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Skin, softly <em>considered.</em>",
      "info": "Use italics for an elegant accent word."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h0", "label": "Extra large" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h0"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Curated skincare, body and beauty essentials — chosen for beautiful textures, considered formulas and rituals that feel like a pause in your day.</p>"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "First button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link"
    },
    {
      "type": "select",
      "id": "button_style_1",
      "label": "First button style",
      "options": [
        { "value": "primary", "label": "Solid" },
        { "value": "secondary", "label": "Outline" },
        { "value": "light", "label": "Light" }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label",
      "default": "Discover your ritual"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "label": "Second button style",
      "options": [
        { "value": "primary", "label": "Solid" },
        { "value": "secondary", "label": "Outline" },
        { "value": "light", "label": "Light" }
      ],
      "default": "secondary"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "desktop_position",
      "label": "Content position on desktop",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-center", "label": "Middle center" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-left"
    },
    {
      "type": "checkbox",
      "id": "boxed",
      "label": "Frosted card behind text",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "bottom", "label": "Text over image (bottom)" },
        { "value": "stack", "label": "Text below image" }
      ],
      "default": "stack"
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Mobile text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "mobile_compact",
      "label": "On phones, show only the heading and first button",
      "default": false,
      "info": "Keeps the headline and main button on the first screen."
    },
    {
      "type": "checkbox",
      "id": "show_scroll_cue",
      "label": "Show scroll cue on desktop",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Sets the text and button colors (and the background below the image on mobile)."
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
