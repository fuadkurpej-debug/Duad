{%- assign brand_text = settings.brand_name | default: shop.name -%}
{%- liquid
  assign shop_name_html = brand_text | escape | replace: '&amp;', '<span class="logo-amp">&amp;</span>'
  assign form_id = 'PasswordNewsletter-' | append: section.id
-%}
<div class="password color-{{ section.settings.color_scheme }}">
  {%- if section.settings.image != blank -%}
    <div class="password__media">
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', loading: 'eager', alt: '' }}
    </div>
  {%- endif -%}
  <div class="password__content page-width page-width--narrow">
    <p class="logo-text">{{ shop_name_html }}</p>
    {%- if section.settings.heading != blank -%}
      <h1 class="h1">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if shop.password_message != blank -%}
      <p class="text-lead">{{ shop.password_message | escape }}</p>
    {%- elsif section.settings.text != blank -%}
      <div class="text-lead">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', id: form_id, class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message" role="status">{% render 'icon', icon: 'check' %}<span>{{ 'general.password_page.notified' | t }}</span></p>
      {%- else -%}
        <div class="newsletter-form__row">
          <div class="field">
            <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.label' | t }}</label>
            <input class="field__input" id="PasswordEmail" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" required>
          </div>
          <button type="submit" class="button">{{ 'general.password_page.notify' | t }}</button>
        </div>
        {%- if form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
    {%- if section.settings.fine_print != blank -%}
      <div class="newsletter__fine-print password__fine-print">{{ section.settings.fine_print }}</div>
    {%- endif -%}

    <details class="password__login">
      <summary class="link">{{ 'general.password_page.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="newsletter-form__row">
          <div class="field">
            <label class="visually-hidden" for="StorefrontPassword">{{ 'general.password_page.password' | t }}</label>
            <input class="field__input" type="password" name="password" id="StorefrontPassword" autocomplete="current-password" placeholder="{{ 'general.password_page.password' | t }}">
          </div>
          <button type="submit" class="button button--secondary">{{ 'general.password_page.enter' | t }}</button>
        </div>
      {%- endform -%}
      <p class="text-small text-muted">{{ 'general.password_page.admin_link_html' | t }}</p>
    </details>

    {%- render 'social-icons' -%}
  </div>
</div>

<style>
  .password { position: relative; display: grid; min-height: 100svh; place-items: center; overflow: hidden; isolation: isolate; }
  .password__media { position: absolute; inset: 0; z-index: -1; }
  .password__media img { width: 100%; height: 100%; object-fit: cover; }
  .password__media::after { content: ""; position: absolute; inset: 0; background: rgba(var(--color-background), 0.72); }
  .password__content { display: grid; justify-items: center; gap: 1.4rem; padding-block: 4rem; text-align: center; }
  .password__content .logo-text { font-size: 2.2rem; margin: 0; }
  .password__content .h1 { margin: 0; }
  .password__login { margin-top: 1rem; display: grid; justify-items: center; gap: 1rem; }
  .password__login summary { list-style: none; cursor: pointer; }
  .password__login summary::-webkit-details-marker { display: none; }
  .password__form { width: min(100%, 26rem); margin-top: 1rem; }
  .password__fine-print { margin: -0.5rem auto 0; text-align: center; }
</style>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Something beautiful is <em>on its way</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Shown when no password page message is set in Online Store → Preferences.",
      "default": "<p>Leave your email and be the first to know when our doors open.</p>"
    },
    {
      "type": "richtext",
      "id": "fine_print",
      "label": "Consent note",
      "default": "<p>By subscribing you agree to receive marketing emails. Unsubscribe anytime. See our <a href=\"/policies/privacy-policy\">privacy policy</a>.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    }
  ]
}
{% endschema %}
