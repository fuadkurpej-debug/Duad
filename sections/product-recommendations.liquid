{%- comment -%}
  "You may also like" — Shopify product recommendations, loaded lazily.
{%- endcomment -%}
<div class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;" data-recommendations-wrapper>
  <div class="page-width">
    {%- render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      align: section.settings.heading_alignment
    -%}
    <product-recommendations
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
      data-limit="{{ section.settings.products_to_show }}"
      data-intents="{{ section.settings.intent }}"
    >
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <ul class="slider slider--desktop-grid" style="--cols-desktop: {{ section.settings.columns_desktop }}; --slide-width: 68%;" role="list">
          {%- for recommendation in recommendations.products -%}
            {%- assign order = forloop.index0 | modulo: 4 -%}
            <li data-recommendation-item>
              {%- render 'product-card', product: recommendation, section_id: section.id, reveal_order: order -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </product-recommendations>
  </div>
</div>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "product-recommendations-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Recommendations are generated by Shopify from your catalogue and orders. Fine-tune them with the Search & Discovery app."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Complete the ritual"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "You may also <em>love</em>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary,related", "label": "Complementary, then related" }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
