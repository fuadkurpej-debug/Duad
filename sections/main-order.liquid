{{ 'customer.css' | asset_url | stylesheet_tag }}
<div class="color-{{ section.settings.color_scheme }}">
  <div class="page-width customer">
    <div class="account__header">
      <div>
        <a href="{{ routes.account_url }}" class="link">{% render 'icon', icon: 'arrow-left' %} {{ 'customer.account.return' | t }}</a>
        <h1 class="h1 gap-top">{{ 'customer.order.title' | t: name: order.name }}</h1>
        {%- assign order_date = order.created_at | time_tag: format: 'date_at_time' -%}
        <p class="text-muted">{{ 'customer.order.date_html' | t: date: order_date }}</p>
      </div>
    </div>

    {%- if order.cancelled -%}
      {%- assign cancelled_date = order.cancelled_at | time_tag: format: 'date_at_time' -%}
      <p class="form-message form-message--error">{{ 'customer.order.cancelled_html' | t: date: cancelled_date }} {{ order.cancel_reason_label }}</p>
    {%- endif -%}

    <div class="account">
      <div class="table-wrap">
        <table class="order-table">
          <thead>
            <tr>
              <th scope="col">{{ 'customer.order.product' | t }}</th>
              <th scope="col">{{ 'customer.order.sku' | t }}</th>
              <th scope="col">{{ 'customer.order.price' | t }}</th>
              <th scope="col">{{ 'customer.order.quantity' | t }}</th>
              <th scope="col">{{ 'customer.order.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for line_item in order.line_items -%}
              <tr>
                <td data-label="{{ 'customer.order.product' | t }}">
                  {%- if line_item.url != blank -%}
                    <a href="{{ line_item.url }}">{{ line_item.title | escape }}</a>
                  {%- else -%}
                    {{ line_item.title | escape }}
                  {%- endif -%}
                  {%- if line_item.fulfillment -%}
                    {%- assign fulfilled_date = line_item.fulfillment.created_at | time_tag: format: 'date' -%}
                    <br><small>{{ 'customer.order.fulfilled_at_html' | t: date: fulfilled_date }}</small>
                    {%- if line_item.fulfillment.tracking_url -%}
                      <br><a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" rel="noopener">{{ 'customer.order.track_shipment' | t }}</a>
                    {%- endif -%}
                  {%- endif -%}
                </td>
                <td data-label="{{ 'customer.order.sku' | t }}">{{ line_item.sku }}</td>
                <td data-label="{{ 'customer.order.price' | t }}">{{ line_item.final_price | money }}</td>
                <td data-label="{{ 'customer.order.quantity' | t }}">{{ line_item.quantity }}</td>
                <td data-label="{{ 'customer.order.total' | t }}">{{ line_item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
          <tfoot>
            <tr>
              <td colspan="4" data-label="{{ 'customer.order.subtotal' | t }}">{{ 'customer.order.subtotal' | t }}</td>
              <td data-label="{{ 'customer.order.subtotal' | t }}">{{ order.line_items_subtotal_price | money }}</td>
            </tr>
            {%- for discount in order.cart_level_discount_applications -%}
              <tr>
                <td colspan="4" data-label="{{ 'customer.order.discount' | t }}">{{ discount.title | escape }}</td>
                <td data-label="{{ 'customer.order.discount' | t }}">&minus;{{ discount.total_allocated_amount | money }}</td>
              </tr>
            {%- endfor -%}
            {%- for shipping_method in order.shipping_methods -%}
              <tr>
                <td colspan="4" data-label="{{ 'customer.order.shipping' | t }}">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title | escape }})</td>
                <td data-label="{{ 'customer.order.shipping' | t }}">{{ shipping_method.price | money }}</td>
              </tr>
            {%- endfor -%}
            {%- for tax_line in order.tax_lines -%}
              <tr>
                <td colspan="4" data-label="{{ 'customer.order.tax' | t }}">{{ 'customer.order.tax' | t }} ({{ tax_line.title | escape }} {{ tax_line.rate | times: 100 }}%)</td>
                <td data-label="{{ 'customer.order.tax' | t }}">{{ tax_line.price | money }}</td>
              </tr>
            {%- endfor -%}
            <tr>
              <td colspan="4" data-label="{{ 'customer.order.total' | t }}"><strong>{{ 'customer.order.total' | t }}</strong></td>
              <td data-label="{{ 'customer.order.total' | t }}"><strong>{{ order.total_net_amount | money_with_currency }}</strong></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <aside class="account-panel">
        <h2 class="h3">{{ 'customer.order.billing_address' | t }}</h2>
        <p><strong>{{ 'customer.order.payment_status' | t }}:</strong> {{ order.financial_status_label }}</p>
        <address style="font-style: normal;">{{ order.billing_address | format_address }}</address>
        <h2 class="h3 gap-top">{{ 'customer.order.shipping_address' | t }}</h2>
        <p><strong>{{ 'customer.order.fulfillment_status' | t }}:</strong> {{ order.fulfillment_status_label }}</p>
        <address style="font-style: normal;">{{ order.shipping_address | format_address }}</address>
      </aside>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer order",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
